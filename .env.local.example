# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings → API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API da Anthropic (console.anthropic.com/settings/keys) — só para o servidor,
# nunca prefixar com NEXT_PUBLIC_. Necessária para a página "Análise do Claude".
ANTHROPIC_API_KEY=
